#!/bin/bash
# Builds this app and measures it in your simulator, then prints a scorecard: each measure, your value, the baseline.
#   ./bench            simulator pass: timing rows, stream CPU, peak memory, app size, the 13 checks
#   ./bench --build    compile only (a minute or so): build errors and the stack rule, no measuring
#   ./bench --device   the same on the iPhone 12 (ours, at the end; --device-full adds the Instruments rows)
# It refuses to run when a locked file has changed (CampfireKit, Fixtures, screenshots, PROMPT.md, this script,
# .bench/, or the debug bar's timing code). One measuring at a time, in turn.
here="$(cd "$(dirname "$0")" && pwd)"
exec python3 -I "$here/.bench/Harness/bench-client.py" "$here" "$@"
