.build/
xcuserdata/
DerivedData/
*.xcresult
.DS_Store
build/
__pycache__/
*.pyc
runs/smoke/
Harness/local.env
# Locked copy of the harness inside each Round 3 build (the repo's Harness/ is the source)
builds/*/.bench/
# Recordings, traces and logs stay local; runs/ keeps only small records
runs/**/*.trace
runs/**/*.mov
runs/**/*.mp4
runs/**/stderr.log
runs/**/transcript.jsonl
# Common stopwatch runs: keep stopwatch.json and median.json; logs and Info.plist copies carry local paths
runs/stopwatch-r5/**/*.log
runs/stopwatch-r5/**/app-Info.plist
